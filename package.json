{
  "name": "streamunify",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "build": "esbuild membership-client-src.js --bundle --minify --format=iife --outfile=membership-client.js",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "sync": "npm run prepare:platforms && cap sync",
    "add:ios": "npx cap add ios",
    "add:android": "npx cap add android",
    "prepare:platforms": "npm run build && node scripts/prepare-platforms.mjs",
    "sync:ios": "npm run prepare:platforms && cap sync ios",
    "sync:android": "npm run prepare:platforms && cap sync android",
    "dev": "node server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "7.1.6",
    "@apple/app-store-server-library": "3.1.0",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.10",
    "@capgo/native-purchases": "7.19.3",
    "@supabase/supabase-js": "2.118.0",
    "google-auth-library": "11.3.1",
    "stripe": "23.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/cli": "7.6.10",
    "@capacitor/ios": "7.6.10",
    "esbuild": "0.25.12"
  }
}

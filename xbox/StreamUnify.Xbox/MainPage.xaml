<Page x:Class="StreamUnify.Xbox.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls" Background="#080D1B">
  <Grid>
    <controls:WebView2 x:Name="Browser" RequiresPointer="Never" />
    <StackPanel x:Name="Failure" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700" Spacing="20">
      <TextBlock Text="StreamUnify couldn't start. Check for Xbox system updates, then try again." TextWrapping="Wrap" FontSize="28" Foreground="White" />
      <Button Content="Try again" Click="Retry_Click" FontSize="24" />
    </StackPanel>
    <Grid x:Name="TextEntry" Visibility="Collapsed" Background="#F5080D1B" KeyDown="TextEntry_KeyDown">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="850" Spacing="24">
        <TextBlock x:Name="TextEntryLabel" Text="Enter text" FontSize="28" Foreground="White" TextWrapping="Wrap" />
        <TextBox x:Name="TextEntryValue" FontSize="30" MaxLength="4096" />
        <PasswordBox x:Name="TextEntryPassword" FontSize="30" MaxLength="4096" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" Spacing="24">
          <Button Content="Done" Click="TextEntryDone_Click" FontSize="26" MinWidth="200" />
          <Button Content="Cancel" Click="TextEntryCancel_Click" FontSize="26" MinWidth="200" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</Page>

<Page x:Class="StreamUnify.Xbox.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#090D19" XYFocusKeyboardNavigation="Enabled">
 <Grid Margin="48,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Spacing="24"><TextBlock Text="StreamUnify" FontSize="36" FontWeight="Bold"/><TextBlock Text="Xbox preview" FontSize="20" VerticalAlignment="Center" Foreground="#B6C4E2"/></StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,24,0,16"><TextBox x:Name="Query" Width="460" MaxLength="120" PlaceholderText="Search movies and TV shows" AutomationProperties.Name="Search movies and TV shows" KeyDown="Query_KeyDown"/><Button Content="Search" Click="Search_Click"/><Button Content="Discover" Click="Discover_Click"/><Button Content="My watchlist" Click="Watchlist_Click"/><Button x:Name="AccountButton" Content="Sign in" Click="Account_Click"/></StackPanel>
  <TextBlock x:Name="Status" Grid.Row="2" Text="Loading…" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite"/>
  <GridView x:Name="Results" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Results_ItemClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Movie and TV results">
   <GridView.ItemTemplate><DataTemplate><StackPanel Width="250" Margin="10" Background="#17203A"><Image Source="{Binding Poster}" Width="250" Height="250" Stretch="UniformToFill"/><TextBlock Text="{Binding Name}" Margin="14,12,14,4" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Margin="14,0,14,14" FontSize="18" Foreground="#B6C4E2" TextWrapping="Wrap"/></StackPanel></DataTemplate></GridView.ItemTemplate>
  </GridView>
 </Grid>
</Page>

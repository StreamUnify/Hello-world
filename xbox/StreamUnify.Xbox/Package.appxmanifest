  <!-- Development identity only. Associate with the reserved Partner Center app before Store packaging. -->
  <Identity Name="StreamUnify.Xbox.Development" Publisher="CN=StreamUnifyDevelopment" Version="0.1.0.0" />
  <mp:PhoneIdentity PhoneProductId="384d64d4-7728-45b5-846f-90af8b578ea3" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties><DisplayName>StreamUnify</DisplayName><PublisherDisplayName>StreamUnify</PublisherDisplayName><Logo>Assets\StoreLogo.png</Logo></Properties>
  <Dependencies><TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" /></Dependencies>
  <Resources><Resource Language="en-US" /></Resources>
